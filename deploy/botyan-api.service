# /etc/systemd/system/botyan-api.service
# API формы обратной связи: слушает 127.0.0.1:3101, nginx проксирует /api/contact.

[Unit]
Description=Botyan contact API
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/botyan-api
EnvironmentFile=/etc/botyan/contact.env
ExecStart=/usr/bin/node /opt/botyan-api/contact-server.mjs
Restart=always
RestartSec=5

# Изоляция
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/botyan-api

StandardOutput=journal
StandardError=journal
SyslogIdentifier=botyan-api

[Install]
WantedBy=multi-user.target
